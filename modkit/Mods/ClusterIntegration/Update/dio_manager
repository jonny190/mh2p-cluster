# Wrapper for `dio_manager` that sets LD_PRELOAD=dio_cluster.so before
# execing the real dio_manager binary. Installed by install.sh; the original
# is preserved at /mnt/app/eso/bin/apps/dio_manager.real. uninstall.sh
# restores the original.

DIO_PRELOAD="/mnt/app/eso/bin/apps/cluster/dio_cluster.so"
DIO_PRELOAD_LOG="/tmp/dio_preload.log"

echo -e "\ndio_date: $(date)"  >> $DIO_PRELOAD_LOG

if [ -f $DIO_PRELOAD ]; then
    export LD_PRELOAD=$DIO_PRELOAD
    echo "dio_preload: $DIO_PRELOAD" found >> $DIO_PRELOAD_LOG
else
    echo "error preload: $DIO_PRELOAD not found" >> $DIO_PRELOAD_LOG
fi

# Diagnostic mode (see the gal wrapper): enable the CarPlay hook's log.
for diag in /mnt/app/eso/bin/apps/cluster/diag_mode /fs/sda0/cluster_diag.txt /fs/sdb0/cluster_diag.txt /fs/usb0_0/cluster_diag.txt; do
    if [ -f "$diag" ]; then
        export DIO_CLUSTER_LOG=1
        echo "dio diag mode: $diag (logging to /tmp/dio_cluster.log)" >> $DIO_PRELOAD_LOG
        break
    fi
done

echo "dio_start: $* LD_PRELOAD: $LD_PRELOAD LD_LIBRARY_PATH:$LD_LIBRARY_PATH" >> $DIO_PRELOAD_LOG

if [ ! -x /mnt/app/eso/bin/apps/dio_manager.real ]; then
    echo "error: /mnt/app/eso/bin/apps/dio_manager.real missing, cannot start dio_manager (restore it from Backup/dio_manager.real on the SD card)" >> $DIO_PRELOAD_LOG
    exit 127
fi

/mnt/app/eso/bin/apps/dio_manager.real "$@"
rc=$?
echo "dio_exit: $rc" >> $DIO_PRELOAD_LOG
exit $rc

